---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact Us - Easy Calorie Calculator"
  description="Get in touch with the Easy Calorie Calculator team. Send us feedback, report a bug, or suggest a new feature."
>
  <Header />

  <!-- Hero Section -->
  <section class="relative w-full overflow-hidden bg-canvas py-12 md:py-16 border-b border-hairline">
    <div class="absolute inset-0 w-full h-full bg-[radial-gradient(at_30%_20%,rgba(80,227,194,0.05)_0px,transparent_50%),radial-gradient(at_70%_20%,rgba(121,40,202,0.04)_0px,transparent_50%)] pointer-events-none"></div>
    <div class="w-full max-w-4xl mx-auto px-4 md:px-6 text-center relative z-10 space-y-4">
      <span class="inline-flex items-center gap-1.5 font-caption-mono text-xs text-body bg-canvas-soft-2 border border-hairline px-3 py-1 rounded-full">
        Get In Touch
      </span>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-ink font-display-lg max-w-xl mx-auto leading-none">
        Contact Us
      </h1>
      <p class="text-sm md:text-base text-body max-w-lg mx-auto leading-relaxed">
        Have a question, found a bug, or want to suggest a feature? We'd love to hear from you.
      </p>
    </div>
  </section>

  <!-- Content -->
  <section class="w-full py-12 md:py-16 bg-canvas-soft">
    <div class="w-full max-w-3xl mx-auto px-4 md:px-6 grid grid-cols-1 md:grid-cols-5 gap-8">

      <!-- Left: Info -->
      <div class="md:col-span-2 space-y-6">
        <div class="space-y-4">
          <h2 class="text-base font-bold text-ink">Ways to reach us</h2>
          <div class="space-y-3">
            {[
              {
                icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z"/><path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z"/></svg>`,
                label: "Email",
                value: "hello@easycaloriecalculator.com",
                href: "mailto:hello@easycaloriecalculator.com",
              },
            ].map(item => (
              <a
                href={item.href}
                class="flex items-start gap-3 p-4 bg-canvas rounded-xl border border-hairline shadow-level-2 hover:border-hairline-strong transition-all group"
              >
                <div class="w-8 h-8 rounded-lg bg-canvas-soft-2 flex items-center justify-center flex-shrink-0 text-ink" set:html={item.icon} />
                <div class="min-w-0">
                  <p class="text-xs font-semibold text-mute uppercase tracking-wider font-caption-mono">{item.label}</p>
                  <p class="text-sm text-ink group-hover:underline underline-offset-2 break-all">{item.value}</p>
                </div>
              </a>
            ))}
          </div>
        </div>

        <div class="space-y-3">
          <h3 class="text-sm font-semibold text-ink">Response Time</h3>
          <p class="text-xs text-body leading-relaxed">
            We typically respond within <strong class="text-ink">1–3 business days</strong>. For bug reports, please include your browser, device, and the steps to reproduce the issue.
          </p>
        </div>

        <div class="space-y-3">
          <h3 class="text-sm font-semibold text-ink">Helpful Links</h3>
          <ul class="space-y-1.5 text-xs text-body">
            <li><a href="/about" class="hover:text-ink transition-colors underline-offset-2 hover:underline">→ About Us</a></li>
            <li><a href="/privacy-policy" class="hover:text-ink transition-colors underline-offset-2 hover:underline">→ Privacy Policy</a></li>
            <li><a href="/terms" class="hover:text-ink transition-colors underline-offset-2 hover:underline">→ Terms & Conditions</a></li>
          </ul>
        </div>
      </div>

      <!-- Right: Form -->
      <div class="md:col-span-3">
        <div class="bg-canvas rounded-xl border border-hairline p-6 md:p-8 shadow-level-2">
          <h2 class="text-base font-bold text-ink mb-6">Send us a message</h2>
          <form id="contact-form" class="space-y-5" novalidate>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="contact-name" class="block text-xs font-semibold text-ink">
                  Full Name <span class="text-error">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="Your name"
                  class="w-full px-3 py-2.5 text-sm bg-canvas-soft-2 border border-hairline rounded-lg text-ink placeholder:text-mute focus:outline-none focus:border-hairline-strong focus:ring-1 focus:ring-hairline-strong transition-all"
                />
              </div>
              <div class="space-y-1.5">
                <label for="contact-email" class="block text-xs font-semibold text-ink">
                  Email Address <span class="text-error">*</span>
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  placeholder="you@example.com"
                  class="w-full px-3 py-2.5 text-sm bg-canvas-soft-2 border border-hairline rounded-lg text-ink placeholder:text-mute focus:outline-none focus:border-hairline-strong focus:ring-1 focus:ring-hairline-strong transition-all"
                />
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="contact-subject" class="block text-xs font-semibold text-ink">Subject</label>
              <select
                id="contact-subject"
                name="subject"
                class="w-full px-3 py-2.5 text-sm bg-canvas-soft-2 border border-hairline rounded-lg text-ink focus:outline-none focus:border-hairline-strong focus:ring-1 focus:ring-hairline-strong transition-all appearance-none cursor-pointer"
              >
                <option value="general">General Inquiry</option>
                <option value="bug">Bug Report</option>
                <option value="feature">Feature Request</option>
                <option value="feedback">Feedback</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="space-y-1.5">
              <label for="contact-message" class="block text-xs font-semibold text-ink">
                Message <span class="text-error">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                required
                rows="5"
                placeholder="Describe your question, feedback, or bug in detail..."
                class="w-full px-3 py-2.5 text-sm bg-canvas-soft-2 border border-hairline rounded-lg text-ink placeholder:text-mute focus:outline-none focus:border-hairline-strong focus:ring-1 focus:ring-hairline-strong transition-all resize-y min-h-[120px]"
              ></textarea>
            </div>

            <!-- Form status messages -->
            <div id="form-success" class="hidden bg-cyan-soft border border-cyan-deep/20 rounded-lg px-4 py-3 text-sm text-cyan-deep font-medium">
              ✓ Thank you! Your message has been sent. We'll get back to you shortly.
            </div>
            <div id="form-error" class="hidden bg-error-soft border border-error/20 rounded-lg px-4 py-3 text-sm text-error-deep font-medium">
              Something went wrong. Please try again or email us directly.
            </div>

            <button
              type="submit"
              id="contact-submit"
              class="w-full flex items-center justify-center gap-2 bg-primary text-on-primary text-sm font-semibold px-5 py-3 rounded-full hover:opacity-90 transition-opacity disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span id="submit-label">Send Message</span>
              <svg id="submit-spinner" class="hidden w-4 h-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
            </button>
          </form>
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('submit-label');
  const submitSpinner = document.getElementById('submit-spinner');
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Show loading state
    if (submitBtn) submitBtn.disabled = true;
    submitLabel?.classList.add('opacity-0');
    submitSpinner?.classList.remove('hidden');
    successMsg?.classList.add('hidden');
    errorMsg?.classList.add('hidden');

    // Simulate submission (replace with real endpoint when ready)
    await new Promise(resolve => setTimeout(resolve, 1200));

    // Show success
    submitLabel?.classList.remove('opacity-0');
    submitSpinner?.classList.add('hidden');
    if (submitBtn) submitBtn.disabled = false;
    successMsg?.classList.remove('hidden');
    form.reset();
  });
</script>
