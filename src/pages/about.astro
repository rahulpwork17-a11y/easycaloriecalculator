---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="About Us - Easy Calorie Calculator"
  description="Learn about Easy Calorie Calculator — our mission to make accurate, science-based calorie and nutrition tools freely accessible to everyone."
>
  <Header />

  <!-- Hero Section -->
  <section class="relative w-full overflow-hidden bg-canvas py-12 md:py-16 border-b border-hairline">
    <div class="absolute inset-0 w-full h-full bg-[radial-gradient(at_30%_20%,rgba(80,227,194,0.05)_0px,transparent_50%),radial-gradient(at_70%_20%,rgba(121,40,202,0.04)_0px,transparent_50%)] pointer-events-none"></div>
    <div class="w-full max-w-4xl mx-auto px-4 md:px-6 text-center relative z-10 space-y-4">
      <span class="inline-flex items-center gap-1.5 font-caption-mono text-xs text-body bg-canvas-soft-2 border border-hairline px-3 py-1 rounded-full">
        Our Story
      </span>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-ink font-display-lg max-w-xl mx-auto leading-none">
        About Easy Calorie Calculator
      </h1>
      <p class="text-sm md:text-base text-body max-w-lg mx-auto leading-relaxed">
        Precision nutrition tools built with science, designed for everyone.
      </p>
    </div>
  </section>

  <!-- Content -->
  <section class="w-full py-12 md:py-16 bg-canvas-soft">
    <div class="w-full max-w-3xl mx-auto px-4 md:px-6 space-y-10">

      <!-- Mission -->
      <div class="bg-canvas rounded-xl border border-hairline p-6 md:p-8 space-y-4 shadow-level-2">
        <div class="flex items-center gap-3 mb-1">
          <div class="w-8 h-8 rounded-lg bg-cyan-soft flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-cyan-deep">
              <path fill-rule="evenodd" d="M14.615 1.595a.75.75 0 0 1 .359.852L12.982 9.75h7.268a.75.75 0 0 1 .548 1.262l-10.5 11.25a.75.75 0 0 1-1.272-.71l1.992-7.302H3.75a.75.75 0 0 1-.548-1.262l10.5-11.25a.75.75 0 0 1 .913-.143Z" clip-rule="evenodd" />
            </svg>
          </div>
          <h2 class="text-lg font-bold text-ink font-display-sm">Our Mission</h2>
        </div>
        <p class="text-sm text-body leading-relaxed">
          Easy Calorie Calculator was built with a single goal: to make <strong class="text-ink">high-quality, science-based nutrition calculations</strong> freely available to everyone — no sign-up, no paywall, no fluff.
        </p>
        <p class="text-sm text-body leading-relaxed">
          We believe that accurate metabolic information should be a baseline right, not a premium feature. Whether you're a fitness enthusiast, a healthcare professional looking for a quick reference, or someone just starting their wellness journey, our tools are built for you.
        </p>
      </div>

      <!-- What We Build -->
      <div class="bg-canvas rounded-xl border border-hairline p-6 md:p-8 space-y-4 shadow-level-2">
        <div class="flex items-center gap-3 mb-1">
          <div class="w-8 h-8 rounded-lg bg-violet-soft flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-violet-deep">
              <path d="M11.644 1.59a.75.75 0 0 1 .712 0l9.75 5.25a.75.75 0 0 1 0 1.32l-9.75 5.25a.75.75 0 0 1-.712 0l-9.75-5.25a.75.75 0 0 1 0-1.32l9.75-5.25Z" />
              <path d="m3.265 10.602 7.668 4.129a2.25 2.25 0 0 0 2.134 0l7.668-4.13 1.37.739a.75.75 0 0 1 0 1.32l-9.75 5.25a.75.75 0 0 1-.71 0l-9.75-5.25a.75.75 0 0 1 0-1.32l1.37-.738Z" />
              <path d="m10.933 19.231-7.668-4.13-1.37.739a.75.75 0 0 0 0 1.32l9.75 5.25c.221.12.489.12.71 0l9.75-5.25a.75.75 0 0 0 0-1.32l-1.37-.738-7.668 4.13a2.25 2.25 0 0 1-2.134-.001Z" />
            </svg>
          </div>
          <h2 class="text-lg font-bold text-ink font-display-sm">What We Build</h2>
        </div>
        <p class="text-sm text-body leading-relaxed">
          We build a growing suite of specialized metabolic and nutrition tools — each one carefully crafted to deliver precision results:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-2">
          {[
            { title: "Daily Calorie Calculator", desc: "BMR + TDEE based on your personal metrics and activity level.", href: "/daily-calculator" },
            { title: "Weight Loss Calculator", desc: "Deficit-based calorie targets for sustainable fat loss.", href: "/weight-loss-calculator" },
            { title: "Maintenance Calculator", desc: "Exactly how many calories to hold your weight steady.", href: "/maintenance-calculator" },
            { title: "Recipe Calorie Calculator", desc: "Break down any meal by its ingredients for full transparency.", href: "/recipe-calculator" },
          ].map(tool => (
            <a href={tool.href} class="group flex flex-col gap-1 p-4 bg-canvas-soft-2 rounded-lg border border-hairline hover:border-hairline-strong transition-all">
              <span class="text-sm font-semibold text-ink group-hover:underline underline-offset-2">{tool.title}</span>
              <span class="text-xs text-body leading-relaxed">{tool.desc}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Science Behind -->
      <div class="bg-canvas rounded-xl border border-hairline p-6 md:p-8 space-y-4 shadow-level-2">
        <div class="flex items-center gap-3 mb-1">
          <div class="w-8 h-8 rounded-lg bg-canvas-soft-2 flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-ink">
              <path d="M11.25 4.533A9.707 9.707 0 0 0 6 3a9.735 9.735 0 0 0-3.25.555.75.75 0 0 0-.5.707v14.25a.75.75 0 0 0 1 .707A8.237 8.237 0 0 1 6 18.75c1.995 0 3.823.707 5.25 1.886V4.533ZM12.75 20.636A8.214 8.214 0 0 1 18 18.75c.966 0 1.89.166 2.75.47a.75.75 0 0 0 1-.708V4.262a.75.75 0 0 0-.5-.707A9.735 9.735 0 0 0 18 3a9.707 9.707 0 0 0-5.25 1.533v16.103Z" />
            </svg>
          </div>
          <h2 class="text-lg font-bold text-ink font-display-sm">The Science Behind Our Tools</h2>
        </div>
        <p class="text-sm text-body leading-relaxed">
          Every calculator on this site is grounded in peer-reviewed research and established nutritional science. We implement multiple validated equations and let you choose:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-sm text-body">
          <li><strong class="text-ink">Mifflin-St Jeor Equation</strong> — Widely considered the most accurate modern BMR formula for most individuals.</li>
          <li><strong class="text-ink">Harris-Benedict Equation</strong> — The classic revised formula, still widely used in clinical settings.</li>
          <li><strong class="text-ink">Katch-McArdle Formula</strong> — For users who know their lean body mass, offering greater precision.</li>
        </ul>
        <p class="text-sm text-body leading-relaxed">
          All formulas are faithfully implemented and clearly labeled, so you always know which equation is powering your result.
        </p>
      </div>

      <!-- Values -->
      <div class="bg-canvas rounded-xl border border-hairline p-6 md:p-8 space-y-4 shadow-level-2">
        <h2 class="text-lg font-bold text-ink font-display-sm">Our Values</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {[
            { icon: "🔒", label: "Privacy First", desc: "Your health data never leaves your browser. No accounts. No data collection." },
            { icon: "🎯", label: "Accuracy Matters", desc: "We implement formulas exactly as published, with clear citations and no approximations." },
            { icon: "♿", label: "For Everyone", desc: "Free, fast, and accessible on any device — no registration required." },
          ].map(v => (
            <div class="flex flex-col gap-2 p-4 bg-canvas-soft-2 rounded-lg border border-hairline text-center">
              <span class="text-2xl">{v.icon}</span>
              <span class="text-sm font-semibold text-ink">{v.label}</span>
              <span class="text-xs text-body leading-relaxed">{v.desc}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="bg-canvas rounded-xl border border-hairline p-6 md:p-8 space-y-4 shadow-level-2 text-center">
        <h2 class="text-lg font-bold text-ink font-display-sm">Have Questions or Feedback?</h2>
        <p class="text-sm text-body leading-relaxed max-w-md mx-auto">
          We're always looking to improve. If you have a question, found a bug, or want to suggest a new feature, we'd love to hear from you.
        </p>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 bg-primary text-on-primary text-sm font-semibold px-5 py-2.5 rounded-full hover:opacity-90 transition-opacity"
        >
          Contact Us
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
