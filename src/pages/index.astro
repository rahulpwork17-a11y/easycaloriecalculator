---
import Layout from '../layouts/Layout.astro';
import CalorieCalculator from '../components/CalorieCalculator.astro';
import EnergyConverter from '../components/EnergyConverter.astro';
---

<Layout title="Calorie Calculator - Lose, Maintain, or Gain Weight." description="Calculate your daily calorie needs based on your age, height, weight, activity level, and goals. Check required calories to lose weight or gain weight.">
  <!-- Sticky Top Navigation Bar -->
  <header class="sticky top-0 z-50 w-full h-[64px] bg-canvas/80 backdrop-blur-md border-b border-hairline flex items-center">
    <div class="w-full max-w-6xl mx-auto px-6 flex justify-between items-center">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 hover:opacity-90 transition-opacity">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-primary">
          <path fill-rule="evenodd" d="M12.969 18.943c-2.172.067-4.449-.106-6.17-1.127a5.016 5.016 0 0 1-2.502-4.329c0-1.905.77-3.921 2.224-5.337a.75.75 0 0 1 1.092.012c.22.253.476.578.709.837.115.127.228.252.337.362a.75.75 0 0 1 .116.899 3.52 3.52 0 0 0-.432 1.549c.074.808.438 1.336 1.006 1.702 1.411.91 3.56.179 4.234-1.242a.75.75 0 0 1 1.15-.356c.208.156.585.467.9.782.154.154.306.314.456.462a.75.75 0 0 1 .073 1.011 8.311 8.311 0 0 1-3.138 3.518c-.866.527-1.782.748-2.693.818Z" clip-rule="evenodd" />
          <path d="M10.422 2.034a.75.75 0 0 1 .655.45c.018.037.222.45.605.99.326.46.75 1.04 1.168 1.57a14.237 14.237 0 0 1 1.704 2.658c.773 1.561.986 2.923.646 3.901a.75.75 0 0 1-1.18.358c-.12-.092-.302-.252-.499-.447a15.647 15.647 0 0 1-1.378-1.584c-.262-.354-.512-.73-.728-1.08a9.199 9.199 0 0 1-.528-1.017.75.75 0 0 1 .08-.799 5.907 5.907 0 0 0 .741-2.822c0-.361-.074-.771-.162-1.177a5.547 5.547 0 0 0-.156-.569.75.75 0 0 1 .232-.782Z" />
        </svg>
        <span class="text-sm font-semibold tracking-tight font-display-sm text-ink select-none">
          easycaloriecalculator.com
        </span>
      </a>

      <!-- Navigation Links -->
      <nav class="hidden md:flex gap-1 items-center">
        <a href="#calculator" class="text-xs font-medium text-body px-3 py-1.5 rounded-full hover:text-ink hover:bg-canvas-soft-2 transition-all">Calculator</a>
        <a href="#converter" class="text-xs font-medium text-body px-3 py-1.5 rounded-full hover:text-ink hover:bg-canvas-soft-2 transition-all">Converter</a>
        <a href="#formulas" class="text-xs font-medium text-body px-3 py-1.5 rounded-full hover:text-ink hover:bg-canvas-soft-2 transition-all">Formulas</a>
        <a href="#faqs" class="text-xs font-medium text-body px-3 py-1.5 rounded-full hover:text-ink hover:bg-canvas-soft-2 transition-all">FAQs</a>
      </nav>

      <!-- Right CTAs -->
      <div class="flex items-center gap-3">
        <!-- Theme Toggle Button -->
        <button
          id="theme-toggle"
          type="button"
          class="w-8 h-8 flex items-center justify-center rounded-full border border-hairline hover:bg-canvas-soft-2 text-ink transition-all duration-150 cursor-pointer"
          aria-label="Toggle theme"
        >
          <!-- Sun Icon (visible in dark mode) -->
          <svg
            id="theme-toggle-sun-icon"
            class="hidden w-4.5 h-4.5 text-ink"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3v2.25m0 13.5V21M21 12h-2.25M5.25 12H3m14.25-6.364-1.591 1.591M6.364 17.636l-1.591 1.591m12.728 0-1.591-1.591M6.364 6.364 4.773 7.955M12 7.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Z"
            />
          </svg>
          <!-- Moon Icon (visible in light mode) -->
          <svg
            id="theme-toggle-moon-icon"
            class="hidden w-4.5 h-4.5 text-ink"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
            />
          </svg>
        </button>

        <span class="font-caption-mono text-[10px] bg-cyan-soft text-cyan-deep border border-cyan-deep/15 px-2 py-0.5 rounded-full font-semibold">
          Web App v1.0
        </span>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative w-full overflow-hidden bg-canvas py-16 md:py-24 border-b border-hairline">
    <!-- Atmospheric Mesh Gradient Background -->
    <div class="absolute inset-0 w-full h-full bg-[radial-gradient(at_20%_20%,rgba(80,227,194,0.07)_0px,transparent_55%),radial-gradient(at_80%_20%,rgba(121,40,202,0.05)_0px,transparent_55%),radial-gradient(at_50%_80%,rgba(255,0,128,0.04)_0px,transparent_55%)] pointer-events-none"></div>

    <div class="w-full max-w-4xl mx-auto px-6 text-center relative z-10 space-y-6">
      <span class="inline-flex items-center gap-1.5 font-caption-mono text-xs text-body bg-canvas-soft-2 border border-hairline px-3 py-1 rounded-full">
        <span class="w-1.5 h-1.5 bg-success rounded-full animate-pulse"></span>
        Interactive Calorie Science Engine
      </span>
      
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-ink font-display-xl max-w-2xl mx-auto leading-none">
        Calculate your daily energy path.
      </h1>
      
      <p class="text-base md:text-lg text-body max-w-xl mx-auto font-body-lg">
        Determine the exact calories your body burns to maintain, lose, or gain weight. Use standard clinical equations, calculate macronutrients, and convert energy units.
      </p>

      <div class="flex justify-center gap-3 pt-2">
        <a href="#calculator" class="bg-primary text-on-primary text-xs font-semibold px-6 py-3 rounded-pill hover:opacity-90 transition-all shadow-level-2">
          Start Calculating
        </a>
        <a href="#converter" class="bg-canvas border border-hairline text-ink text-xs font-semibold px-6 py-3 rounded-pill hover:bg-canvas-soft transition-all">
          Food Converter
        </a>
      </div>
    </div>
  </section>

  <!-- Main Calculator Section -->
  <section id="calculator" class="w-full py-16 md:py-24 bg-canvas-soft">
    <div class="w-full max-w-6xl mx-auto px-6 space-y-8">
      <div class="max-w-xl">
        <span class="font-caption-mono text-xs text-body uppercase tracking-wider block mb-2">Calculator Engine</span>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-ink font-display-lg">
          Daily Calories & Weight Plan
        </h2>
        <p class="text-sm text-body mt-1">
          Adjust the variables to get instantaneous results for maintenance, weight loss, or weight gain targets.
        </p>
      </div>

      <CalorieCalculator />
    </div>
  </section>

  <!-- Quick Converter Showcase Section (Dark) -->
  <section id="converter" class="w-full py-16 bg-canvas border-y border-hairline relative">
    <div class="w-full max-w-6xl mx-auto px-6">
      <EnergyConverter />
    </div>
  </section>

  <!-- Clinical Formulas & Accordion FAQ Section -->
  <section id="formulas" class="w-full py-16 md:py-24 bg-canvas-soft">
    <div class="w-full max-w-4xl mx-auto px-6 space-y-12">
      <!-- Title -->
      <div class="text-center max-w-xl mx-auto space-y-3">
        <span class="font-caption-mono text-xs text-body uppercase tracking-wider block">Clinical Math</span>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-ink font-display-lg">
          Understand the Equations.
        </h2>
        <p class="text-sm text-body">
          How metabolic calculations estimate your body's daily caloric budget.
        </p>
      </div>

      <!-- Formula Detail Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Mifflin Card -->
        <div class="bg-canvas border border-hairline rounded-lg p-5 space-y-3 shadow-level-2">
          <h4 class="text-sm font-semibold font-caption-mono uppercase text-ink">Mifflin-St Jeor</h4>
          <p class="text-xs text-body leading-relaxed">
            Introduced in 1990, it is currently the industry standard for estimating BMR without body fat parameters. Highly reliable for average body composition.
          </p>
          <div class="bg-canvas-soft-2 p-2.5 rounded-sm border border-hairline font-code text-[11px] text-body leading-normal">
            Men: 10W + 6.25H - 5A + 5<br>
            Women: 10W + 6.25H - 5A - 161
          </div>
        </div>

        <!-- Harris Card -->
        <div class="bg-canvas border border-hairline rounded-lg p-5 space-y-3 shadow-level-2">
          <h4 class="text-sm font-semibold font-caption-mono uppercase text-ink">Harris-Benedict</h4>
          <p class="text-xs text-body leading-relaxed">
            One of the earliest equations, formulated in 1918 and revised in 1984. It is still widely cited, though it tends to slightly overestimate BMR for modern, less active lifestyles.
          </p>
          <div class="bg-canvas-soft-2 p-2.5 rounded-sm border border-hairline font-code text-[11px] text-body leading-normal">
            Men: 13.397W + 4.799H - 5.677A + 88.362<br>
            Women: 9.247W + 3.098H - 4.330A + 447.593
          </div>
        </div>

        <!-- Katch Card -->
        <div class="bg-canvas border border-hairline rounded-lg p-5 space-y-3 shadow-level-2">
          <h4 class="text-sm font-semibold font-caption-mono uppercase text-ink">Katch-McArdle</h4>
          <p class="text-xs text-body leading-relaxed">
            Calculates BMR based strictly on Lean Body Mass (LBM) rather than total weight. The most accurate formula for muscular athletes or individuals with precise body fat metrics.
          </p>
          <div class="bg-canvas-soft-2 p-2.5 rounded-sm border border-hairline font-code text-[11px] text-body leading-normal">
            BMR = 370 + 21.6 &times; LBM (kg)<br>
            LBM = Weight &times; (1 - BF%)
          </div>
        </div>
      </div>

      <!-- FAQ details Accordions -->
      <div id="faqs" class="space-y-4 pt-6 border-t border-hairline">
        <h3 class="text-lg font-bold text-ink mb-6 text-center font-display-sm">Frequently Asked Questions</h3>

        <!-- FAQ 1 -->
        <details class="group bg-canvas border border-hairline rounded-lg p-5 shadow-level-1 cursor-pointer [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center text-sm font-semibold text-ink select-none font-body-md-strong list-none">
            What is BMR and TDEE?
            <span class="transition group-open:rotate-180 text-mute">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </span>
          </summary>
          <div class="text-xs text-body leading-relaxed mt-4 pt-3 border-t border-hairline space-y-2">
            <p>
              <strong>Basal Metabolic Rate (BMR)</strong> is the baseline energy expenditure your body burns at complete rest just to keep vital functions (breathing, organs, circulation) operating.
            </p>
            <p>
              <strong>Total Daily Energy Expenditure (TDEE)</strong> is the actual number of calories your body burns in 24 hours including physical activity. It is calculated by multiplying your BMR by your physical activity multiplier factor.
            </p>
          </div>
        </details>

        <!-- FAQ 2 -->
        <details class="group bg-canvas border border-hairline rounded-lg p-5 shadow-level-1 cursor-pointer [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center text-sm font-semibold text-ink select-none font-body-md-strong list-none">
            How many calories should I reduce to lose weight safely?
            <span class="transition group-open:rotate-180 text-mute">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </span>
          </summary>
          <div class="text-xs text-body leading-relaxed mt-4 pt-3 border-t border-hairline space-y-2">
            <p>
              Generally, a daily deficit of <strong>500 calories</strong> will yield roughly 1.0 lbs (0.5 kg) of fat loss per week, and a deficit of <strong>250 calories</strong> targets about 0.5 lbs (0.25 kg) per week.
            </p>
            <p>
              To prevent metabolic deceleration and hormonal imbalances, it is highly recommended that men do not consume fewer than 1,200 calories per day, and women do not consume fewer than 1,000 calories per day, unless under direct medical guidance.
            </p>
          </div>
        </details>

        <!-- FAQ 3 -->
        <details class="group bg-canvas border border-hairline rounded-lg p-5 shadow-level-1 cursor-pointer [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center text-sm font-semibold text-ink select-none font-body-md-strong list-none">
            How are macro-nutrient calculations derived?
            <span class="transition group-open:rotate-180 text-mute">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </span>
          </summary>
          <div class="text-xs text-body leading-relaxed mt-4 pt-3 border-t border-hairline space-y-2">
            <p>
              Macronutrient needs are determined by allocating target daily energy values into percentages:
            </p>
            <ul class="list-disc pl-4 space-y-1 mt-1">
              <li><strong>Balanced:</strong> 50% Carbs, 20% Protein, 30% Fat. Good for overall health and general lifestyle.</li>
              <li><strong>High Protein:</strong> 40% Carbs, 30% Protein, 30% Fat. Optimal for weight lifters and muscle retention.</li>
              <li><strong>Low Carb:</strong> 25% Carbs, 35% Protein, 40% Fat. Helps manage blood sugar and insulin spikes.</li>
              <li><strong>Keto:</strong> 5% Carbs, 25% Protein, 70% Fat. Induces metabolic ketosis where the body burns fat for primary fuel.</li>
            </ul>
            <p class="mt-2 text-[11px] text-mute">
              Calorie-to-gram conversion values: Carbohydrates and Proteins have 4 kcal per gram; Fats have 9 kcal per gram.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="w-full bg-canvas border-t border-hairline py-16">
    <div class="w-full max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-12 gap-8 text-sm">
      <!-- Info Column -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-primary">
            <path fill-rule="evenodd" d="M12.969 18.943c-2.172.067-4.449-.106-6.17-1.127a5.016 5.016 0 0 1-2.502-4.329c0-1.905.77-3.921 2.224-5.337a.75.75 0 0 1 1.092.012c.22.253.476.578.709.837.115.127.228.252.337.362a.75.75 0 0 1 .116.899 3.52 3.52 0 0 0-.432 1.549c.074.808.438 1.336 1.006 1.702 1.411.91 3.56.179 4.234-1.242a.75.75 0 0 1 1.15-.356c.208.156.585.467.9.782.154.154.306.314.456.462a.75.75 0 0 1 .073 1.011 8.311 8.311 0 0 1-3.138 3.518c-.866.527-1.782.748-2.693.818Z" clip-rule="evenodd" />
            <path d="M10.422 2.034a.75.75 0 0 1 .655.45c.018.037.222.45.605.99.326.46.75 1.04 1.168 1.57a14.237 14.237 0 0 1 1.704 2.658c.773 1.561.986 2.923.646 3.901a.75.75 0 0 1-1.18.358c-.12-.092-.302-.252-.499-.447a15.647 15.647 0 0 1-1.378-1.584c-.262-.354-.512-.73-.728-1.08a9.199 9.199 0 0 1-.528-1.017.75.75 0 0 1 .08-.799 5.907 5.907 0 0 0 .741-2.822c0-.361-.074-.771-.162-1.177a5.547 5.547 0 0 0-.156-.569.75.75 0 0 1 .232-.782Z" />
          </svg>
          <span class="font-semibold text-ink font-caption-mono uppercase tracking-wider text-[11px]">Calorie Calculator</span>
        </div>
        <p class="text-xs text-body leading-normal max-w-sm">
          A premium utility designed to deliver high-precision metabolic calculations. Calculations are estimations and should not substitute medical evaluation, diagnostic assessments, or clinical nutrition therapy.
        </p>
        <p class="text-[10px] text-mute leading-normal">
          &copy; {new Date().getFullYear()} easycaloriecalculator.com. All rights reserved.
        </p>
      </div>

      <!-- Columns 2-4 (Links) -->
      <div class="md:col-span-2 space-y-3">
        <h5 class="text-xs font-semibold uppercase tracking-wider text-ink font-caption-mono">Formulas</h5>
        <ul class="space-y-1.5 text-xs text-body">
          <li><a href="#formulas" class="hover:text-ink transition-colors">Mifflin-St Jeor</a></li>
          <li><a href="#formulas" class="hover:text-ink transition-colors">Harris-Benedict</a></li>
          <li><a href="#formulas" class="hover:text-ink transition-colors">Katch-McArdle</a></li>
        </ul>
      </div>

      <div class="md:col-span-2 space-y-3">
        <h5 class="text-xs font-semibold uppercase tracking-wider text-ink font-caption-mono">Features</h5>
        <ul class="space-y-1.5 text-xs text-body">
          <li><a href="#calculator" class="hover:text-ink transition-colors">TDEE Estimator</a></li>
          <li><a href="#calculator" class="hover:text-ink transition-colors">Macro Breakdown</a></li>
          <li><a href="#converter" class="hover:text-ink transition-colors">Energy Converter</a></li>
        </ul>
      </div>

      <div class="md:col-span-3 space-y-3">
        <h5 class="text-xs font-semibold uppercase tracking-wider text-ink font-caption-mono">Disclaimer</h5>
        <p class="text-[10px] text-mute leading-relaxed">
          Please consult a qualified dietitian, healthcare practitioner, or primary care provider before making rapid dietary changes, initiating calorie restrictions, or starting high-deficit plans.
        </p>
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Client-side theme toggle logic
  document.addEventListener('DOMContentLoaded', () => {
    const themeToggle = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('theme-toggle-sun-icon');
    const moonIcon = document.getElementById('theme-toggle-moon-icon');

    // Function to update icon visibilities based on current document class
    function updateToggleIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        sunIcon?.classList.remove('hidden');
        moonIcon?.classList.add('hidden');
      } else {
        sunIcon?.classList.add('hidden');
        moonIcon?.classList.remove('hidden');
      }
    }

    // Run on initial load
    updateToggleIcons();

    // Toggle click handler
    themeToggle?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
      updateToggleIcons();
    });
  });
</script>
