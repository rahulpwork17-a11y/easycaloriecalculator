---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DailyCalc from '../components/DailyCalc.astro';
import EnergyConverter from '../components/EnergyConverter.astro';
import FAQSection from '../components/FAQSection.astro';
---

<Layout title="Calorie Calculator - Free Daily Calorie Intake Calculator" description="Use our free calorie calculator to estimate your daily energy needs. Compare BMR & TDEE formulas. Includes a maintenance calorie calculator, food calorie calculator, calorie calculator for weight loss, recipe calorie calculator, and calorie calculator to gain weight.">
  <Header />

  <!-- Hero Section -->
  <section class="relative w-full overflow-hidden bg-canvas py-16 md:py-24 border-b border-hairline">
    <!-- Atmospheric Mesh Gradient Background -->
    <div class="absolute inset-0 w-full h-full bg-[radial-gradient(at_20%_20%,rgba(80,227,194,0.07)_0px,transparent_55%),radial-gradient(at_80%_20%,rgba(121,40,202,0.05)_0px,transparent_55%),radial-gradient(at_50%_80%,rgba(255,0,128,0.04)_0px,transparent_55%)] pointer-events-none"></div>

    <div class="w-full max-w-4xl mx-auto px-6 text-center relative z-10 space-y-6">
      <span class="inline-flex items-center gap-1.5 font-caption-mono text-xs text-body bg-canvas-soft-2 border border-hairline px-3 py-1 rounded-full">
        <span class="w-1.5 h-1.5 bg-success rounded-full animate-pulse"></span>
        Calorie Calculator Platform
      </span>
      
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-ink font-display-xl max-w-3xl mx-auto leading-none">
        Specialized tools for your energy path.
      </h1>
      
      <p class="text-base md:text-lg text-body max-w-2xl mx-auto font-body-lg">
        Consolidate your fitness and nutritional planning. Compute calorie requirements, deficit plans, baseline TDEE, and home-cooked meal densities in one place.
      </p>
    </div>
  </section>

  <!-- Immediate Access Calorie Calculator -->
  <section id="calculator" class="w-full py-16 md:py-24 bg-canvas border-b border-hairline">
    <div class="w-full max-w-6xl mx-auto px-6">
      <div class="max-w-xl mb-12">
        <span class="font-caption-mono text-xs text-body uppercase tracking-wider block mb-2">Immediate Access</span>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-ink font-display-lg">
          Daily Calorie Calculator
        </h2>
        <p class="text-sm text-body mt-1">
          Calculate your energy needs, macro distributions, and weight goals instantly below.
        </p>
      </div>
      <DailyCalc />
    </div>
  </section>

  <!-- Platform Suite Portal Cards -->
  <section id="portal" class="w-full py-16 md:py-24 bg-canvas-soft border-b border-hairline">
    <div class="w-full max-w-6xl mx-auto px-6 space-y-12">
      <!-- Section Header -->
      <div class="max-w-xl">
        <span class="font-caption-mono text-xs text-body uppercase tracking-wider block mb-2">Metabolic Suite</span>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-ink font-display-lg">
          Select a Specialized Calculator
        </h2>
        <p class="text-sm text-body mt-1">
          Explore our suite of specialized clinical calculators, designed with strict mathematical consistency.
        </p>
      </div>

      <!-- Grid list -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        <!-- 1. Daily Calorie Calculator -->
        <a href="/daily-calculator" class="group bg-canvas border border-hairline rounded-lg p-6 hover:border-hairline-strong shadow-level-2 hover:shadow-level-3 transition-all duration-200 flex flex-col justify-between hover:scale-[1.01]">
          <div>
            <div class="w-10 h-10 rounded-sm bg-cyan-soft/10 text-cyan-deep flex items-center justify-center mb-4 border border-cyan-deep/15">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-ink font-display-md mb-2 group-hover:text-link transition-colors">
              Daily Calorie Calculator
            </h3>
            <p class="text-xs md:text-sm text-body leading-relaxed">
              Estimate BMR, TDEE, and a full spectrum of daily intake targets to maintain, lose, or gain weight. Includes customizable macro-nutrient distributions.
            </p>
          </div>
          <span class="text-xs font-semibold text-link mt-6 flex items-center gap-1 font-caption-mono">
            Calculate Daily Needs &rarr;
          </span>
        </a>

        <!-- 2. Weight Loss Calculator -->
        <a href="/weight-loss-calculator" class="group bg-canvas border border-hairline rounded-lg p-6 hover:border-hairline-strong shadow-level-2 hover:shadow-level-3 transition-all duration-200 flex flex-col justify-between hover:scale-[1.01]">
          <div>
            <div class="w-10 h-10 rounded-sm bg-error-soft/30 text-error-deep flex items-center justify-center mb-4 border border-error/15">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-ink font-display-md mb-2 group-hover:text-link transition-colors">
              Weight Loss Calorie Calculator
            </h3>
            <p class="text-xs md:text-sm text-body leading-relaxed">
              Formulate a structured caloric deficit. Input target weight loss margins to evaluate deficit timelines, meal budgets, and safety warnings.
            </p>
          </div>
          <span class="text-xs font-semibold text-link mt-6 flex items-center gap-1 font-caption-mono">
            Formulate Deficit Plan &rarr;
          </span>
        </a>

        <!-- 3. Maintenance Calorie Calculator -->
        <a href="/maintenance-calculator" class="group bg-canvas border border-hairline rounded-lg p-6 hover:border-hairline-strong shadow-level-2 hover:shadow-level-3 transition-all duration-200 flex flex-col justify-between hover:scale-[1.01]">
          <div>
            <div class="w-10 h-10 rounded-sm bg-link-bg-soft text-link flex items-center justify-center mb-4 border border-link/10">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-ink font-display-md mb-2 group-hover:text-link transition-colors">
              Maintenance Calorie Calculator
            </h3>
            <p class="text-xs md:text-sm text-body leading-relaxed">
              Evaluate baseline TDEE (Total Daily Energy Expenditure) and BMR. Compare clinical math equations (Mifflin, Harris, Katch) side-by-side.
            </p>
          </div>
          <span class="text-xs font-semibold text-link mt-6 flex items-center gap-1 font-caption-mono">
            Determine Baseline TDEE &rarr;
          </span>
        </a>

        <!-- 4. Recipe Calorie Calculator -->
        <a href="/recipe-calculator" class="group bg-canvas border border-hairline rounded-lg p-6 hover:border-hairline-strong shadow-level-2 hover:shadow-level-3 transition-all duration-200 flex flex-col justify-between hover:scale-[1.01]">
          <div>
            <div class="w-10 h-10 rounded-sm bg-warning-soft/30 text-warning-deep flex items-center justify-center mb-4 border border-warning/15">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-ink font-display-md mb-2 group-hover:text-link transition-colors">
              Recipe Calorie Calculator
            </h3>
            <p class="text-xs md:text-sm text-body leading-relaxed">
              Analyze home-cooked meal calorie density. Add multiple ingredients dynamically to identify total recipe calories and per-serving macro layouts.
            </p>
          </div>
          <span class="text-xs font-semibold text-link mt-6 flex items-center gap-1 font-caption-mono">
            Calculate Meal Density &rarr;
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Converter Section (Stays intact) -->
  <section id="converter" class="w-full py-16 bg-canvas border-b border-hairline relative">
    <div class="w-full max-w-6xl mx-auto px-6">
      <EnergyConverter />
    </div>
  </section>

  <!-- Detailed SEO Educational Guide -->
  <section id="guide" class="w-full py-16 md:py-24 bg-canvas border-b border-hairline relative">
    <div class="absolute inset-0 w-full h-full bg-[radial-gradient(at_70%_80%,rgba(121,40,202,0.02)_0px,transparent_50%)] pointer-events-none"></div>
    <div class="w-full max-w-4xl mx-auto px-6 relative z-10 space-y-12">
      <!-- Title -->
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <span class="font-caption-mono text-xs text-body uppercase tracking-wider block">Comprehensive Guide</span>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-ink font-display-lg">
          Metabolic Science & Energy Management
        </h2>
        <p class="text-sm text-body">
          How to systematically use a calorie calculator to achieve your weight management goals.
        </p>
      </div>

      <!-- Text Content -->
      <div class="prose dark:prose-invert max-w-none text-sm text-body leading-relaxed space-y-8">
        <div class="space-y-4">
          <h3 class="text-lg font-semibold text-ink font-display-sm">1. Understanding the Role of a Calorie Calculator</h3>
          <p>
            At its core, a <strong>calorie calculator</strong> is a physiological modeling tool that estimates the amount of food energy your body requires to support daily life and physical activities. Energy is measured in kilocalories (kcal) or kilojoules (kJ). Maintaining an exact awareness of your daily energy balance is the single most important element in achieving healthy weight changes or preserving your current physique.
          </p>
          <p>
            Every physical change you experience is governed by the laws of thermodynamics. When you consume exactly the amount of energy your body expends, you maintain a state of caloric equilibrium. Deviations from this baseline trigger your body to either store excess energy as fat or burn existing tissues for fuel.
          </p>
        </div>

        <div class="space-y-4">
          <h3 class="text-lg font-semibold text-ink font-display-sm">2. Basal Metabolic Rate vs. Daily Energy Expenditure</h3>
          <p>
            To successfully estimate your requirements, a calorie calculator breaks down energy consumption into two primary numbers:
          </p>
          <ul class="list-disc pl-5 space-y-2">
            <li>
              <strong>Basal Metabolic Rate (BMR):</strong> The baseline number of calories your organs burn at absolute rest in a thermo-neutral environment. BMR is the cost of keeping your brain active, lungs breathing, heart beating, and cells repairing, without any external physical activity.
            </li>
            <li>
              <strong>Total Daily Energy Expenditure (TDEE):</strong> The actual number of calories burned in a full 24-hour cycle. It represents your BMR multiplied by a physical activity factor representing physical activity levels (exercise, labor) and the thermic effect of food (digesting nutrients).
            </li>
          </ul>
        </div>

        <div class="space-y-4">
          <h3 class="text-lg font-semibold text-ink font-display-sm">3. Finding Your Baseline with a Maintenance Calorie Calculator</h3>
          <p>
            To formulate a custom nutrition plan, you must first calculate your daily maintenance calories. A <strong>maintenance calorie calculator</strong> estimates your baseline TDEE using standardized mathematical models. Consuming exactly this amount allows you to maintain your weight stable over time.
          </p>
          <p>
            Different populations have unique muscle densities and metabolic baselines. To ensure maximum clinical consistency, this platform computes BMR and TDEE across three leading scientific formulas:
          </p>
          <ul class="list-disc pl-5 space-y-2">
            <li>
              <strong>Mifflin-St Jeor:</strong> The current global clinical standard for estimating energy requirements when body fat is unknown.
            </li>
            <li>
              <strong>Revised Harris-Benedict:</strong> A historically prominent formula developed in 1918 and updated in 1984, widely respected for standard metabolic calculations.
            </li>
            <li>
              <strong>Katch-McArdle:</strong> The most precise formula for athletic individuals. It relies strictly on Lean Body Mass (LBM), excluding body fat from the equation to calculate pure active metabolic tissue requirements.
            </li>
          </ul>
        </div>

        <div class="space-y-4">
          <h3 class="text-lg font-semibold text-ink font-display-sm">4. Customizing a Calorie Calculator for Weight Loss</h3>
          <p>
            Fat loss requires a sustained energy deficit. A <strong>calorie calculator for weight loss</strong> helps you calculate the safe, sustainable calorie deficit needed to reduce fat mass while preserving active muscle tissue.
          </p>
          <p>
            Medical standards recommend aiming for a target weight loss of 0.5 to 2.0 pounds (0.25 to 1.0 kg) per week. This targets a deficit of 250 to 1,000 calories below your daily TDEE. However, cutting calories too aggressively can trigger a metabolic down-regulation (the starvation response) where thyroid output slows, muscle tissue is metabolized for fuel, and severe hunger hormones are triggered. To prevent this, our weight loss calculators include integrated safety thresholds, warning users if daily targets drop below 1,200 calories (for males) or 1,000 calories (for females).
          </p>
        </div>

        <div class="space-y-4">
          <h3 class="text-lg font-semibold text-ink font-display-sm">5. Using a Calorie Calculator to Gain Weight</h3>
          <p>
            To build lean mass or recover from metabolic down-regulation, you must establish an energy surplus. A <strong>calorie calculator to gain weight</strong> calculates a controlled surplus, ensuring that mass gains are lean muscle rather than fat.
          </p>
          <p>
            For clean muscle hypertrophy, a minor daily surplus of 250 to 500 calories is recommended. This surplus provides the extra amino acids and glycogen needed to rebuild muscle tissue damaged during strength training. Excesses beyond 500 calories per day typically accumulate as body fat, making a metered, controlled surplus the optimal choice.
          </p>
        </div>

        <div class="space-y-4">
          <h3 class="text-lg font-semibold text-ink font-display-sm">6. Meal Planning with a Food Calorie Calculator & Recipe Calorie Calculator</h3>
          <p>
            Knowing your target numbers is only half the battle; translating those numbers into meals requires daily tracking. A <strong>food calorie calculator</strong> and a <strong>recipe calorie calculator</strong> make this process seamless.
          </p>
          <p>
            Calorie density is the number of calories in a specific weight of food (kcal/g). Foods high in water and fiber (like leafy vegetables, fruits, and lean proteins) have low calorie densities. Foods rich in fats or processed sugars (like cooking oils, butter, cheese, and pastries) have high calorie densities.
          </p>
          <p>
            By using a recipe calorie calculator, you can add individual ingredients dynamically, specify the exact servings, and analyze the total energy density ratio of your meals. This lets you identify high-density ingredients and substitute them to create large, satisfying, voluminous meals that keep you full while staying under your target calorie limits.
          </p>
        </div>

        <div class="space-y-4">
          <h3 class="text-lg font-semibold text-ink font-display-sm">7. Understanding Macronutrient Energy Ratios</h3>
          <p>
            Once your calorie goals are set, organizing those calories into macronutrients optimizes your body composition:
          </p>
          <div class="overflow-x-auto">
            <table class="w-full text-xs text-left border-collapse border border-hairline font-mono my-4">
              <thead>
                <tr class="bg-canvas-soft-2 text-ink border-b border-hairline">
                  <th class="p-2.5 font-bold">Macronutrient</th>
                  <th class="p-2.5 font-bold">Energy Value</th>
                  <th class="p-2.5 font-bold">Primary Physiological Role</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline text-body">
                <tr>
                  <td class="p-2.5 font-semibold text-ink">Protein</td>
                  <td class="p-2.5">4 kcal / gram</td>
                  <td class="p-2.5">Muscle repair, tissue synthesis, high satiety trigger</td>
                </tr>
                <tr>
                  <td class="p-2.5 font-semibold text-ink">Carbohydrates</td>
                  <td class="p-2.5">4 kcal / gram</td>
                  <td class="p-2.5">Glycogen restoration, workout fuel, brain metabolism</td>
                </tr>
                <tr>
                  <td class="p-2.5 font-semibold text-ink">Fats</td>
                  <td class="p-2.5">9 kcal / gram</td>
                  <td class="p-2.5">Hormonal production, vitamin absorption, cellular structure</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p>
            Adjusting these splits according to your metabolic requirements helps you maintain high energy levels, optimize workout recovery, and stick to your calorie goals comfortably.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Clinical Formulas & Accordion FAQ Section (Stays intact on Home portal) -->
  <section id="formulas" class="w-full py-16 md:py-24 bg-canvas-soft">
    <div class="w-full max-w-4xl mx-auto px-6 space-y-12">
      <!-- Title -->
      <div class="text-center max-w-xl mx-auto space-y-3">
        <span class="font-caption-mono text-xs text-body uppercase tracking-wider block">Clinical Math</span>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-ink font-display-lg">
          Understand the Equations.
        </h2>
        <p class="text-sm text-body">
          How metabolic calculations estimate your body's daily caloric budget.
        </p>
      </div>

      <!-- Formula Detail Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Mifflin Card -->
        <div class="bg-canvas border border-hairline rounded-lg p-5 space-y-3 shadow-level-2">
          <h4 class="text-sm font-semibold font-caption-mono uppercase text-ink">Mifflin-St Jeor</h4>
          <p class="text-xs text-body leading-relaxed">
            Introduced in 1990, it is currently the industry standard for estimating BMR without body fat parameters. Highly reliable for average body composition.
          </p>
          <div class="bg-canvas-soft-2 p-2.5 rounded-sm border border-hairline font-code text-[11px] text-body leading-normal">
            Men: 10W + 6.25H - 5A + 5<br>
            Women: 10W + 6.25H - 5A - 161
          </div>
        </div>

        <!-- Harris Card -->
        <div class="bg-canvas border border-hairline rounded-lg p-5 space-y-3 shadow-level-2">
          <h4 class="text-sm font-semibold font-caption-mono uppercase text-ink">Harris-Benedict</h4>
          <p class="text-xs text-body leading-relaxed">
            One of the earliest equations, formulated in 1918 and revised in 1984. It is still widely cited, though it tends to slightly overestimate BMR for modern, less active lifestyles.
          </p>
          <div class="bg-canvas-soft-2 p-2.5 rounded-sm border border-hairline font-code text-[11px] text-body leading-normal">
            Men: 13.397W + 4.799H - 5.677A + 88.362<br>
            Women: 9.247W + 3.098H - 4.330A + 447.593
          </div>
        </div>

        <!-- Katch Card -->
        <div class="bg-canvas border border-hairline rounded-lg p-5 space-y-3 shadow-level-2">
          <h4 class="text-sm font-semibold font-caption-mono uppercase text-ink">Katch-McArdle</h4>
          <p class="text-xs text-body leading-relaxed">
            Calculates BMR based strictly on Lean Body Mass (LBM) rather than total weight. The most accurate formula for muscular athletes or individuals with precise body fat metrics.
          </p>
          <div class="bg-canvas-soft-2 p-2.5 rounded-sm border border-hairline font-code text-[11px] text-body leading-normal">
            BMR = 370 + 21.6 &times; LBM (kg)<br>
            LBM = Weight &times; (1 - BF%)
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <FAQSection />
    </div>
  </section>

  <Footer />
</Layout>
