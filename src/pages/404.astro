---
import Layout from '../layouts/Layout.astro';

const title = "Page Not Found";
const description = "The page you're looking for doesn't exist or has been moved.";
---

<Layout title={title} description={description}>
  <main class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="max-w-md w-full text-center">
      <div class="mb-8 animate-fade-in-up">
        <span class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-error-soft text-error dark:bg-error-soft dark:text-error-deep">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </span>
      </div>
      
      <h1 class="font-display-lg text-ink mb-4 animate-fade-in-up" style="animation-delay: 0.1s;">
        404
      </h1>
      
      <h2 class="font-display-md text-ink mb-4 animate-fade-in-up" style="animation-delay: 0.2s;">
        Page Not Found
      </h2>
      
      <p class="font-body-lg text-body mb-8 animate-fade-in-up" style="animation-delay: 0.3s;">
        Sorry, we couldn't find the page you're looking for. It might have been moved, deleted, or never existed.
      </p>
      
      <div class="space-y-4 animate-fade-in-up" style="animation-delay: 0.4s;">
        <a 
          href="/" 
          class="inline-flex items-center justify-center px-6 py-3 bg-primary text-on-primary rounded-lg font-body-md-strong hover:opacity-90 transition-opacity shadow-level-2"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Go to Homepage
        </a>
        
        <a 
          href="/daily-calculator" 
          class="inline-flex items-center justify-center px-6 py-3 border border-hairline-strong dark:border-hairline-strong rounded-lg font-body-md-strong hover:bg-canvas-soft-2 dark:hover:bg-canvas-soft-2 transition-colors shadow-level-1"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
          </svg>
          Try Calorie Calculator
        </a>
      </div>
      
      <div class="mt-12 pt-8 border-t border-hairline animate-fade-in-up" style="animation-delay: 0.5s;">
        <p class="font-body-sm text-mute mb-4">
          Still can't find what you need?
        </p>
        <a 
          href="/contact" 
          class="font-body-sm-strong text-primary hover:underline transition-colors"
        >
          Contact Support
        </a>
      </div>
    </div>
  </main>
</Layout>