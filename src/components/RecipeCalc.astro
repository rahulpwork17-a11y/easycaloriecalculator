---
// RecipeCalc.astro
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch w-full max-w-6xl mx-auto">
  <!-- Inputs Card -->
  <div class="lg:col-span-6 bg-canvas border border-hairline shadow-level-3 rounded-lg p-6 flex flex-col justify-between">
    <div>
      <span class="block text-xs font-semibold uppercase tracking-wider text-mute font-caption-mono mb-4">
        Recipe Ingredients & Servings
      </span>

      <form id="recipe-form" class="space-y-6" onsubmit="return false;">
        <!-- Servings -->
        <div>
          <label for="recipe-input-servings" class="block text-xs font-semibold uppercase tracking-wider text-body mb-2 font-caption-mono">
            Number of Servings
          </label>
          <input
            type="number"
            id="recipe-input-servings"
            name="servings"
            autocomplete="off"
            min="1"
            max="100"
            value="4"
            required
            class="w-full max-w-[120px] bg-canvas text-ink border border-hairline rounded-sm px-3 text-sm focus:outline-none focus:ring-1 focus:ring-ink focus:border-ink transition-all duration-200 h-10"
          />
          <span class="text-xs text-mute mt-1 block">Divide total recipe calories by this number</span>
        </div>

        <!-- Ingredients List Container -->
        <div>
          <div class="flex justify-between items-baseline mb-3">
            <label class="block text-xs font-semibold uppercase tracking-wider text-body font-caption-mono">
              Ingredients
            </label>
            <span class="text-xs text-mute font-caption-mono">Add weights and calorie indexes</span>
          </div>

          <!-- Dynamic ingredient rows -->
          <div id="ingredients-list" class="space-y-3">
            <!-- Row 1 (default) -->
            <div class="ingredient-row flex flex-col gap-2 bg-canvas-soft-2 border border-hairline rounded-sm p-3 relative group transition-all duration-200">
              <!-- Name (full width) -->
              <input
                type="text"
                name="ing-name"
                autocomplete="off"
                placeholder="e.g. Chicken Breast"
                class="ing-name w-full bg-canvas text-ink border border-hairline rounded-sm px-2 text-xs h-8 focus:outline-none focus:ring-1 focus:ring-ink focus:border-ink transition-all"
              />
              <!-- Weight + Calories + Delete on same row -->
              <div class="flex gap-2 items-center">
                <div class="relative flex-1">
                  <input
                    type="number"
                    name="ing-weight"
                    autocomplete="off"
                    placeholder="200"
                    min="0.1"
                    step="any"
                    class="ing-weight w-full bg-canvas text-ink border border-hairline rounded-sm px-2 pr-6 text-xs h-8 focus:outline-none focus:ring-1 focus:ring-ink focus:border-ink transition-all"
                  />
                  <span class="absolute right-1.5 top-1.5 text-[9px] text-mute font-caption-mono">g</span>
                </div>
                <div class="relative flex-1">
                  <input
                    type="number"
                    name="ing-calories"
                    autocomplete="off"
                    placeholder="165"
                    min="0"
                    class="ing-calories w-full bg-canvas text-ink border border-hairline rounded-sm px-2 pr-10 text-xs h-8 focus:outline-none focus:ring-1 focus:ring-ink focus:border-ink transition-all"
                    title="Calories per 100 grams of this food item"
                  />
                  <span class="absolute right-1 top-1.5 text-[9px] text-mute font-caption-mono">kcal/100g</span>
                </div>
                <!-- Delete button -->
                <button
                  type="button"
                  class="btn-delete-row flex-shrink-0 text-mute hover:text-error transition-colors duration-150 p-1"
                  title="Delete ingredient"
                  aria-label="Delete ingredient row"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4.5 h-4.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Add Ingredient button -->
          <button
            type="button"
            id="btn-add-ingredient"
            class="mt-3 text-xs font-semibold text-link hover:text-link-deep flex items-center gap-1 font-caption-mono focus:outline-none"
          >
            + Add Another Ingredient
          </button>
        </div>
      </form>
    </div>

    <!-- Submit buttons -->
    <div class="mt-8 flex gap-4">
      <button
        type="button"
        id="recipe-btn-calculate"
        class="flex-1 bg-primary text-on-primary font-medium text-sm py-3 rounded-pill hover:bg-ink hover:opacity-90 active:scale-[0.98] transition-all duration-150 cursor-pointer shadow-level-2"
      >
        Calculate Meal Density
      </button>
      <button
        type="button"
        id="recipe-btn-clear"
        class="bg-canvas border border-hairline text-ink font-medium text-sm px-6 py-3 rounded-pill hover:bg-canvas-soft hover:border-hairline-strong transition-all duration-150 cursor-pointer"
      >
        Clear Recipe
      </button>
    </div>
  </div>

  <!-- Results Dashboard -->
  <div class="lg:col-span-6 flex flex-col">
    <!-- Empty State -->
    <div id="recipe-results-empty" class="flex-1 bg-canvas border border-hairline shadow-level-2 rounded-lg p-10 text-center flex flex-col justify-center items-center h-full min-h-[420px] transition-all duration-300">
      <div class="w-12 h-12 bg-canvas-soft border border-hairline rounded-full flex items-center justify-center mb-4 text-mute">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-ink mb-2">Recipe Breakdown</h3>
      <p class="text-sm text-body max-w-sm">
        Add your recipe items with weights and calorie descriptors, then click "Calculate Meal Density" to analyze serving size calories, nutritional mass, and food energy density.
      </p>
    </div>

    <!-- Active Dashboard -->
    <div id="recipe-results-active" class="hidden flex-1 flex flex-col space-y-6 transition-all duration-300 animate-fade-in-up">
      <!-- Main Metric highlights -->
      <div class="bg-canvas border border-hairline shadow-level-3 rounded-lg p-6 relative overflow-hidden">
        <div class="absolute -right-20 -top-20 w-48 h-48 bg-gradient-to-br from-cyan-soft via-violet-soft to-highlight-pink opacity-25 blur-3xl pointer-events-none rounded-full"></div>
        
        <span class="text-xs font-semibold uppercase tracking-wider text-mute font-caption-mono block mb-1">
          Recipe Energy Output
        </span>
        
        <div class="grid grid-cols-2 gap-4 mt-4">
          <!-- Total Calories -->
          <div class="border-r border-hairline pr-2">
            <span class="text-xs text-body font-caption-mono uppercase block mb-1">Total Recipe Calories</span>
            <div class="flex items-baseline">
              <h2 id="recipe-res-total-cal" class="text-2xl md:text-3xl font-bold tracking-tight text-ink font-display-md leading-none">0</h2>
              <span class="text-xs text-mute font-caption-mono ml-1">kcal</span>
            </div>
            <span class="text-[10px] text-mute block mt-1">Total mass: <span id="recipe-res-total-weight">0</span>g</span>
          </div>

          <!-- Calories Per Serving -->
          <div class="pl-2">
            <span class="text-xs text-primary font-caption-mono uppercase block mb-1">Calories Per Serving</span>
            <div class="flex items-baseline">
              <h2 id="recipe-res-serving-cal" class="text-2xl md:text-3xl font-bold tracking-tight text-primary font-display-md leading-none">0</h2>
              <span class="text-xs text-mute font-caption-mono ml-1">kcal</span>
            </div>
            <span class="text-[10px] text-mute block mt-1">For <span id="recipe-res-servings-count">4</span> servings</span>
          </div>
        </div>
      </div>

      <!-- Calorie Density Classification Card -->
      <div class="bg-canvas border border-hairline shadow-level-2 rounded-lg p-5 space-y-4">
        <div class="flex justify-between items-baseline border-b border-hairline pb-3">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-ink font-caption-mono font-bold">
            Meal Calorie Density
          </h3>
          <span id="density-badge" class="text-xs font-semibold px-2 py-0.5 rounded-full font-caption-mono bg-canvas-soft border border-hairline">
            Calculating
          </span>
        </div>

        <div class="space-y-2">
          <div class="flex justify-between items-center text-xs">
            <span class="text-body">Calorie Density Ratio</span>
            <span class="font-bold text-ink"><span id="density-ratio">0.00</span> kcal/g</span>
          </div>
          
          <!-- Bar scale slider pointer representation -->
          <div class="w-full bg-canvas-soft-2 h-4 rounded-full overflow-hidden border border-hairline relative flex items-center">
            <!-- 0.0 to 3.0 scale markings -->
            <div class="absolute left-[20%] h-full w-[1px] bg-hairline-strong z-10"></div> <!-- 0.6 border -->
            <div class="absolute left-[50%] h-full w-[1px] bg-hairline-strong z-10"></div> <!-- 1.5 border -->
            
            <!-- Color backgrounds representing low, moderate, high -->
            <div class="w-[20%] h-full bg-success/20"></div>
            <div class="w-[30%] h-full bg-warning/20"></div>
            <div class="w-[50%] h-full bg-error/20"></div>

            <!-- Arrow Indicator -->
            <div id="density-indicator" class="absolute w-2.5 h-2.5 bg-ink rounded-full border border-canvas shadow-level-2 transition-all duration-500" style="left: 0%"></div>
          </div>

          <div class="flex justify-between text-[9px] text-mute font-caption-mono pt-1">
            <span>Low (&le;0.6 kcal/g)</span>
            <span>Moderate (0.6 - 1.5)</span>
            <span>High (&ge;1.5 kcal/g)</span>
          </div>
        </div>

        <p id="density-desc" class="text-[11px] text-body leading-relaxed pt-2 border-t border-hairline">
          Adding ingredients…
        </p>
      </div>

      <!-- Meal Macro-Nutrients Planner -->
      <div class="bg-canvas border border-hairline shadow-level-3 rounded-lg p-5 space-y-4">
        <div class="border-b border-hairline pb-3">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-ink font-caption-mono font-bold">
            Servings Macro Planner
          </h3>
          <p class="text-[10px] text-mute mt-1">
            Divide your serving calorie budget into target macronutrient weights.
          </p>
        </div>

        <div>
          <label for="recipe-macro-diet" class="block text-[10px] font-semibold uppercase tracking-wider text-body mb-2 font-caption-mono">
            Select Planner Diet Target
          </label>
          <select
            id="recipe-macro-diet"
            name="macro-diet"
            class="w-full bg-canvas text-ink border border-hairline rounded-sm px-3 text-xs focus:outline-none focus:ring-1 focus:ring-ink focus:border-ink h-9 cursor-pointer"
          >
            <option value="balanced" selected>Balanced Portion (50% Carb, 20% Pro, 30% Fat)</option>
            <option value="high-protein">High Protein Portion (40% Carb, 30% Pro, 30% Fat)</option>
            <option value="low-carb">Low Carb Portion (25% Carb, 35% Pro, 40% Fat)</option>
          </select>
        </div>

        <!-- Serving Macros Gram outputs -->
        <div class="grid grid-cols-3 gap-4 pt-2">
          <!-- Carbs -->
          <div class="bg-canvas-soft-2 border border-hairline rounded-sm p-3 text-center hover:border-hairline-strong transition-all">
            <span class="text-[10px] font-semibold uppercase text-mute tracking-wider font-caption-mono block mb-1">Carbs (g)</span>
            <span id="recipe-macro-carbs" class="text-base font-bold text-ink">0</span>g
          </div>
          <!-- Proteins -->
          <div class="bg-canvas-soft border border-hairline rounded-sm p-3 text-center hover:border-hairline-strong transition-all">
            <span class="text-[10px] font-semibold uppercase text-mute tracking-wider font-caption-mono block mb-1">Protein (g)</span>
            <span id="recipe-macro-protein" class="text-base font-bold text-ink">0</span>g
          </div>
          <!-- Fats -->
          <div class="bg-canvas-soft-2 border border-hairline rounded-sm p-3 text-center hover:border-hairline-strong transition-all">
            <span class="text-[10px] font-semibold uppercase text-mute tracking-wider font-caption-mono block mb-1">Fat (g)</span>
            <span id="recipe-macro-fats" class="text-base font-bold text-ink">0</span>g
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const listContainer = document.getElementById('ingredients-list');
    const btnAdd = document.getElementById('btn-add-ingredient');
    
    const inputServings = document.getElementById('recipe-input-servings');
    const resultsEmpty = document.getElementById('recipe-results-empty');
    const resultsActive = document.getElementById('recipe-results-active');

    // Outputs
    const resTotalCal = document.getElementById('recipe-res-total-cal');
    const resTotalWeight = document.getElementById('recipe-res-total-weight');
    const resServingCal = document.getElementById('recipe-res-serving-cal');
    const resServingsCount = document.getElementById('recipe-res-servings-count');

    // Density
    const densityBadge = document.getElementById('density-badge');
    const densityRatio = document.getElementById('density-ratio');
    const densityIndicator = document.getElementById('density-indicator');
    const densityDesc = document.getElementById('density-desc');

    // Planner Macros
    const selectDiet = document.getElementById('recipe-macro-diet');
    const mCarbs = document.getElementById('recipe-macro-carbs');
    const mProtein = document.getElementById('recipe-macro-protein');
    const mFats = document.getElementById('recipe-macro-fats');

    const btnCalculate = document.getElementById('recipe-btn-calculate');
    const btnClear = document.getElementById('recipe-btn-clear');

    let calculatedServingCalories = 0;

    // Helper: binds events to a single row delete button
    function bindRowDelete(row) {
      const btnDelete = row.querySelector('.btn-delete-row');
      btnDelete?.addEventListener('click', () => {
        // Ensure at least one row remains
        if (listContainer && listContainer.querySelectorAll('.ingredient-row').length > 1) {
          row.remove();
        } else {
          alert("A recipe must have at least one ingredient!");
        }
      });
    }

    // Bind existing first row
    const firstRow = document.querySelector('.ingredient-row');
    if (firstRow) bindRowDelete(firstRow);

    // Add ingredient row
    btnAdd?.addEventListener('click', () => {
      if (!listContainer) return;
      
      const newRow = document.createElement('div');
      newRow.className = "ingredient-row flex flex-col gap-2 bg-canvas-soft-2 border border-hairline rounded-sm p-3 relative group transition-all duration-200";
      newRow.innerHTML = `
        <input
          type="text"
          name="ing-name"
          autocomplete="off"
          placeholder="e.g. Olive Oil"
          class="ing-name w-full bg-canvas text-ink border border-hairline rounded-sm px-2 text-xs h-8 focus:outline-none focus:ring-1 focus:ring-ink focus:border-ink transition-all"
        />
        <div class="flex gap-2 items-center">
          <div class="relative flex-1">
            <input
              type="number"
              name="ing-weight"
              autocomplete="off"
              placeholder="15"
              min="0.1"
              step="any"
              class="ing-weight w-full bg-canvas text-ink border border-hairline rounded-sm px-2 pr-6 text-xs h-8 focus:outline-none focus:ring-1 focus:ring-ink focus:border-ink transition-all"
            />
            <span class="absolute right-1.5 top-1.5 text-[9px] text-mute font-caption-mono">g</span>
          </div>
          <div class="relative flex-1">
            <input
              type="number"
              name="ing-calories"
              autocomplete="off"
              placeholder="884"
              min="0"
              class="ing-calories w-full bg-canvas text-ink border border-hairline rounded-sm px-2 pr-10 text-xs h-8 focus:outline-none focus:ring-1 focus:ring-ink focus:border-ink transition-all"
            />
            <span class="absolute right-1 top-1.5 text-[9px] text-mute font-caption-mono">kcal/100g</span>
          </div>
          <!-- Delete button -->
          <button
            type="button"
            class="btn-delete-row flex-shrink-0 text-mute hover:text-error transition-colors duration-150 p-1"
            aria-label="Delete ingredient row"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4.5 h-4.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
            </svg>
          </button>
        </div>
      `;

      listContainer.appendChild(newRow);
      bindRowDelete(newRow);
    });

    // Run Calculations
    btnCalculate?.addEventListener('click', () => {
      const servings = parseInt(inputServings.value);
      if (isNaN(servings) || servings < 1) {
        alert("Please enter a valid number of servings (min 1).");
        inputServings.focus();
        return;
      }

      const rows = listContainer?.querySelectorAll('.ingredient-row') || [];
      let totalCalories = 0;
      let totalWeight = 0;
      let validIngredientCount = 0;

      rows.forEach((row, index) => {
        const weightInput = row.querySelector('.ing-weight');
        const caloriesInput = row.querySelector('.ing-calories');
        
        const weight = parseFloat(weightInput.value);
        const caloriesPer100 = parseFloat(caloriesInput.value);

        if (!isNaN(weight) && weight > 0 && !isNaN(caloriesPer100) && caloriesPer100 >= 0) {
          // calories = (weight in grams / 100) * caloriesPer100
          const calContribution = (weight / 100) * caloriesPer100;
          totalCalories += calContribution;
          totalWeight += weight;
          validIngredientCount++;
        }
      });

      if (validIngredientCount === 0) {
        alert("Please fill out at least one ingredient with a weight (g) and calories (kcal/100g) index!");
        return;
      }

      calculatedServingCalories = totalCalories / servings;

      // Update basic fields
      if (resTotalCal) resTotalCal.textContent = Math.round(totalCalories).toLocaleString();
      if (resTotalWeight) resTotalWeight.textContent = Math.round(totalWeight).toLocaleString();
      if (resServingCal) resServingCal.textContent = Math.round(calculatedServingCalories).toLocaleString();
      if (resServingsCount) resServingsCount.textContent = servings.toString();

      // Density calculation: ratio = kcal / totalWeight (in grams)
      const ratio = totalCalories / totalWeight;
      if (densityRatio) densityRatio.textContent = ratio.toFixed(2);

      // Determine category and set styling
      // Low: <= 0.6 | Moderate: 0.6 - 1.5 | High: >= 1.5
      let category = "Moderate";
      let descText = "";
      let colorClass = "";
      let borderClass = "";

      // Density indicator location: map ratio to left%
      // 0.0 -> 0%, 0.6 -> 20%, 1.5 -> 50%, 3.0+ -> 95%
      let leftPercent = 0;
      if (ratio <= 0.6) {
        leftPercent = (ratio / 0.6) * 20; // 0 to 20%
        category = "Low Density";
        colorClass = "bg-success/15 text-success-deep border-success/20";
        descText = "This recipe has a <strong>low calorie density</strong>. Such foods contain high water/fiber fractions (like vegetables, lean proteins, or oats) and let you consume satisfying portions for fewer total calories, aiding weight loss.";
      } else if (ratio <= 1.5) {
        leftPercent = 20 + ((ratio - 0.6) / 0.9) * 30; // 20% to 50%
        category = "Moderate Density";
        colorClass = "bg-warning/15 text-warning-deep border-warning/20";
        descText = "This recipe has a <strong>moderate calorie density</strong>. These foods (like whole grains, beans, cooked rice, or lean meats) represent balanced, healthy nutrition. Pay moderate attention to portion sizes.";
      } else {
        // clamp max ratio represented in bar to 3.0
        const clampedRatio = Math.min(3.0, ratio);
        leftPercent = 50 + ((clampedRatio - 1.5) / 1.5) * 45; // 50% to 95%
        category = "High Density";
        colorClass = "bg-error/15 text-error-deep border-error/20";
        descText = "This recipe has a <strong>high calorie density</strong>. Concentrated energy items (nuts, oils, cheese, baked pastries) fall into this category. Portions should be carefully measured, as small serving sizes accumulate large calories.";
      }

      if (densityBadge) {
        densityBadge.textContent = category;
        densityBadge.className = `text-xs font-semibold px-2 py-0.5 rounded-full font-caption-mono border ${colorClass}`;
      }
      if (densityIndicator) {
        densityIndicator.style.left = `calc(${leftPercent}% - 5px)`;
      }
      if (densityDesc) {
        densityDesc.innerHTML = descText;
      }

      // Toggle views
      resultsEmpty?.classList.add('hidden');
      resultsActive?.classList.remove('hidden');

      // Update Serving Macros
      updateRecipeMacros();
    });

    function updateRecipeMacros() {
      if (calculatedServingCalories === 0) return;

      const diet = selectDiet.value;
      let pCarb = 50, pPro = 20, pFat = 30;

      if (diet === 'high-protein') {
        pCarb = 40; pPro = 30; pFat = 30;
      } else if (diet === 'low-carb') {
        pCarb = 25; pPro = 35; pFat = 40;
      }

      // Convert target calories per serving to grams
      const carbCal = calculatedServingCalories * (pCarb / 100);
      const proCal = calculatedServingCalories * (pPro / 100);
      const fatCal = calculatedServingCalories * (pFat / 100);

      if (mCarbs) mCarbs.textContent = Math.round(carbCal / 4).toString();
      if (mProtein) mProtein.textContent = Math.round(proCal / 4).toString();
      if (mFats) mFats.textContent = Math.round(fatCal / 9).toString();
    }

    selectDiet?.addEventListener('change', updateRecipeMacros);

    // Clear form
    btnClear?.addEventListener('click', () => {
      inputServings.value = "4";
      
      // Clear rows to just one empty row
      if (listContainer) {
        listContainer.innerHTML = `
          <div class="ingredient-row grid grid-cols-12 gap-2 items-center bg-canvas-soft-2 border border-hairline rounded-sm p-3 relative group transition-all duration-200">
            <div class="col-span-5">
              <input
                type="text"
                name="ing-name"
                autocomplete="off"
                placeholder="e.g. Chicken Breast"
                class="ing-name w-full bg-canvas text-ink border border-hairline rounded-sm px-2 text-xs h-8 focus:outline-none focus:ring-1 focus:ring-ink focus:border-ink transition-all"
              />
            </div>
            <div class="col-span-3 relative">
              <input
                type="number"
                name="ing-weight"
                autocomplete="off"
                placeholder="200"
                min="0.1"
                step="any"
                class="ing-weight w-full bg-canvas text-ink border border-hairline rounded-sm px-2 pr-6 text-xs h-8 focus:outline-none focus:ring-1 focus:ring-ink focus:border-ink transition-all"
              />
              <span class="absolute right-1.5 top-1.5 text-[9px] text-mute font-caption-mono">g</span>
            </div>
            <div class="col-span-3 relative">
              <input
                type="number"
                name="ing-calories"
                autocomplete="off"
                placeholder="165"
                min="0"
                class="ing-calories w-full bg-canvas text-ink border border-hairline rounded-sm px-2 pr-8 text-xs h-8 focus:outline-none focus:ring-1 focus:ring-ink focus:border-ink transition-all"
              />
              <span class="absolute right-1 top-1.5 text-[9px] text-mute font-caption-mono">kcal/100g</span>
            </div>
            <div class="col-span-1 flex justify-center">
              <button
                type="button"
                class="btn-delete-row text-mute hover:text-error transition-colors duration-150 p-1"
                aria-label="Delete ingredient row"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4.5 h-4.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                </svg>
              </button>
            </div>
          </div>
        `;
        const r = listContainer.querySelector('.ingredient-row');
        if (r) bindRowDelete(r);
      }

      calculatedServingCalories = 0;
      resultsActive?.classList.add('hidden');
      resultsEmpty?.classList.remove('hidden');
    });
  });
</script>
