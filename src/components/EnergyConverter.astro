---
// EnergyConverter.astro
---

<div class="w-full max-w-4xl mx-auto bg-neutral-950 text-white border border-white/10 rounded-lg p-6 md:p-8 relative overflow-hidden shadow-level-4">
  <!-- Mesh backdrop highlight -->
  <div class="absolute -left-20 -bottom-20 w-48 h-48 bg-gradient-to-br from-gradient-preview-start to-gradient-preview-end opacity-20 blur-3xl pointer-events-none rounded-full"></div>
  
  <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b border-white/10">
    <div>
      <span class="text-xs font-semibold uppercase tracking-wider text-mute font-caption-mono text-cyan-soft block mb-1">
        Quick Utilities
      </span>
      <h3 class="text-xl md:text-2xl font-bold tracking-tight font-display-md text-white">
        Food Energy Converter
      </h3>
      <p class="text-sm text-body text-white/70 mt-1 max-w-md">
        Convert between Calories (kcal), calories (cal), Kilojoules (kJ), and Joules (J) instantly.
      </p>
    </div>
  </div>

  <div class="relative z-10 grid grid-cols-1 md:grid-cols-9 gap-4 items-center mt-6">
    <!-- Source Value -->
    <div class="md:col-span-3">
      <label for="conv-source-val" class="block text-[10px] font-semibold uppercase tracking-wider text-white/60 mb-2 font-caption-mono">
        From Value
      </label>
      <input
        type="number"
        id="conv-source-val"
        value="1"
        step="any"
        class="w-full bg-white/5 text-white border border-white/10 rounded-sm px-3 text-sm focus:outline-none focus:border-white/30 transition-all duration-200 h-10"
      />
    </div>

    <!-- Source Unit -->
    <div class="md:col-span-2">
      <label for="conv-source-unit" class="block text-[10px] font-semibold uppercase tracking-wider text-white/60 mb-2 font-caption-mono">
        From Unit
      </label>
      <select
        id="conv-source-unit"
        class="w-full bg-white/5 text-white border border-white/10 rounded-sm px-2 text-sm focus:outline-none focus:border-white/30 transition-all duration-200 h-10 cursor-pointer"
      >
        <option value="kcal" selected class="bg-neutral-900 text-white">Calorie [kcal]</option>
        <option value="cal" class="bg-neutral-900 text-white">calorie [cal]</option>
        <option value="kJ" class="bg-neutral-900 text-white">Kilojoule [kJ]</option>
        <option value="J" class="bg-neutral-900 text-white">Joule [J]</option>
      </select>
    </div>

    <!-- Equal Sign -->
    <div class="md:col-span-1 flex justify-center items-center pt-4 md:pt-0">
      <span class="text-xl font-bold text-white/40 font-display-sm">=</span>
    </div>

    <!-- Target Value -->
    <div class="md:col-span-3">
      <label for="conv-target-val" class="block text-[10px] font-semibold uppercase tracking-wider text-white/60 mb-2 font-caption-mono">
        Converted Value
      </label>
      <div class="relative">
        <input
          type="text"
          id="conv-target-val"
          readonly
          value="4.184"
          class="w-full bg-white/5 text-white/90 border border-white/10 rounded-sm px-3 text-sm focus:outline-none h-10 select-all cursor-default"
        />
        <button 
          id="btn-copy-conv" 
          type="button"
          class="absolute right-2 top-2 text-white/40 hover:text-white transition-colors duration-150 p-1"
          title="Copy value"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H5.4m1.5 12.5a3 3 0 1 1-3-3m3 3a3 3 0 1 0-3-3M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Target Unit -->
    <div class="md:col-span-2 md:col-start-8">
      <label for="conv-target-unit" class="block text-[10px] font-semibold uppercase tracking-wider text-white/60 mb-2 font-caption-mono">
        To Unit
      </label>
      <select
        id="conv-target-unit"
        class="w-full bg-white/5 text-white border border-white/10 rounded-sm px-2 text-sm focus:outline-none focus:border-white/30 transition-all duration-200 h-10 cursor-pointer"
      >
        <option value="kcal" class="bg-neutral-900 text-white">Calorie [kcal]</option>
        <option value="cal" class="bg-neutral-900 text-white">calorie [cal]</option>
        <option value="kJ" selected class="bg-neutral-900 text-white">Kilojoule [kJ]</option>
        <option value="J" class="bg-neutral-900 text-white">Joule [J]</option>
      </select>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const srcVal = document.getElementById('conv-source-val');
    const srcUnit = document.getElementById('conv-source-unit');
    const tgtVal = document.getElementById('conv-target-val');
    const tgtUnit = document.getElementById('conv-target-unit');
    const btnCopy = document.getElementById('btn-copy-conv');

    // 1 kcal = 1000 cal = 4.184 kJ = 4184 J
    // Conversion factors to base unit "Joule (J)"
    const factorsToJoule = {
      J: 1,
      kJ: 1000,
      cal: 4.184,
      kcal: 4184
    };

    function recalculate() {
      const input = parseFloat(srcVal.value);
      if (isNaN(input)) {
        tgtVal.value = "";
        return;
      }

      const unitFrom = srcUnit.value;
      const unitTo = tgtUnit.value;

      // Convert from source unit to Joules
      const joules = input * factorsToJoule[unitFrom];
      
      // Convert from Joules to target unit
      const result = joules / factorsToJoule[unitTo];

      // Render formatting (rounded to 4 decimal places, trimming trailing zeros)
      if (result === 0) {
        tgtVal.value = "0";
      } else {
        // Remove trailing decimals if it is integer
        tgtVal.value = Number(result.toFixed(5)).toString();
      }
    }

    // Event bindings
    srcVal.addEventListener('input', recalculate);
    srcUnit.addEventListener('change', recalculate);
    tgtUnit.addEventListener('change', recalculate);

    // Copy to clipboard
    btnCopy.addEventListener('click', () => {
      const text = tgtVal.value;
      if (text) {
        navigator.clipboard.writeText(text).then(() => {
          // Visual copy feedback: change icon colors or scale
          btnCopy.classList.add('text-success');
          setTimeout(() => {
            btnCopy.classList.remove('text-success');
          }, 1500);
        });
      }
    });

    // Run initial calculation
    recalculate();
  });
</script>
