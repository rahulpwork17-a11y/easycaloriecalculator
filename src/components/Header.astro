---
// Header.astro
const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/\/$/, ""); // normalize trailing slashes
---

<header class="sticky top-0 z-50 w-full h-[64px] bg-canvas/80 backdrop-blur-md border-b border-hairline flex items-center">
  <div class="w-full max-w-6xl mx-auto px-4 md:px-6 flex justify-between items-center">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 hover:opacity-90 transition-opacity min-w-0">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 rounded-[6px]" style="background:#000; padding:3px;">
        <rect width="18" height="18" x="3" y="3" rx="2" fill="none"/>
        <path d="M17 12h-2l-2 5-2-10-2 5H7"/>
      </svg>
      <span class="select-none flex items-baseline gap-[3px] leading-none">
        <span class="text-[15px] font-bold tracking-tight text-ink" style="font-family: var(--font-sans); letter-spacing: -0.4px;">Calorie</span>
        <span class="text-[15px] font-semibold tracking-tight text-body" style="font-family: var(--font-sans); letter-spacing: -0.4px;">Calculator</span>
      </span>
    </a>

    <!-- Navigation Links (desktop) -->
    <nav class="hidden md:flex gap-1 items-center">
      <a 
        href="/daily-calculator" 
        class={`text-sm font-medium px-3 py-1.5 rounded-full transition-all ${
          cleanPath === "/daily-calculator" 
            ? "bg-canvas-soft-2 text-ink font-semibold" 
            : "text-body hover:text-ink hover:bg-canvas-soft-2"
        }`}
      >
        Daily Calorie
      </a>
      <a 
        href="/weight-loss-calculator" 
        class={`text-sm font-medium px-3 py-1.5 rounded-full transition-all ${
          cleanPath === "/weight-loss-calculator" 
            ? "bg-canvas-soft-2 text-ink font-semibold" 
            : "text-body hover:text-ink hover:bg-canvas-soft-2"
        }`}
      >
        Weight Loss
      </a>
      <a 
        href="/maintenance-calculator" 
        class={`text-sm font-medium px-3 py-1.5 rounded-full transition-all ${
          cleanPath === "/maintenance-calculator" 
            ? "bg-canvas-soft-2 text-ink font-semibold" 
            : "text-body hover:text-ink hover:bg-canvas-soft-2"
        }`}
      >
        Maintenance
      </a>
      <a 
        href="/recipe-calculator" 
        class={`text-sm font-medium px-3 py-1.5 rounded-full transition-all ${
          cleanPath === "/recipe-calculator" 
            ? "bg-canvas-soft-2 text-ink font-semibold" 
            : "text-body hover:text-ink hover:bg-canvas-soft-2"
        }`}
      >
        Recipe Calorie
      </a>
    </nav>

    <!-- Right CTAs -->
    <div class="flex items-center gap-2">
      <!-- Theme Toggle Button -->
      <button
        id="theme-toggle"
        type="button"
        class="w-8 h-8 flex items-center justify-center rounded-full border border-hairline hover:bg-canvas-soft-2 text-ink transition-all duration-150 cursor-pointer"
        aria-label="Toggle theme"
      >
        <!-- Sun Icon (visible in dark mode) -->
        <svg
          id="theme-toggle-sun-icon"
          class="hidden w-4.5 h-4.5 text-ink"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v2.25m0 13.5V21M21 12h-2.25M5.25 12H3m14.25-6.364-1.591 1.591M6.364 17.636l-1.591 1.591m12.728 0-1.591-1.591M6.364 6.364 4.773 7.955M12 7.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Z"
          />
        </svg>
        <!-- Moon Icon (visible in light mode) -->
        <svg
          id="theme-toggle-moon-icon"
          class="hidden w-4.5 h-4.5 text-ink"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
          />
        </svg>
      </button>


      <!-- Hamburger button (mobile only) -->

      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden w-8 h-8 flex items-center justify-center rounded-full border border-hairline hover:bg-canvas-soft-2 text-ink transition-all duration-150 cursor-pointer"
        aria-label="Open navigation menu"
        aria-expanded="false"
      >
        <svg id="mobile-menu-icon-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="mobile-menu-icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 hidden">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Dropdown -->
  <div
    id="mobile-nav"
    class="hidden absolute top-[64px] left-0 right-0 bg-canvas border-b border-hairline shadow-level-3 z-50 md:hidden"
  >
    <nav class="flex flex-col px-4 py-3 gap-1">
      <a
        href="/daily-calculator"
        class={`text-sm font-medium px-4 py-3 rounded-lg transition-all ${
          cleanPath === "/daily-calculator"
            ? "bg-canvas-soft-2 text-ink font-semibold"
            : "text-body hover:text-ink hover:bg-canvas-soft-2"
        }`}
      >
        Daily Calorie Calculator
      </a>
      <a
        href="/weight-loss-calculator"
        class={`text-sm font-medium px-4 py-3 rounded-lg transition-all ${
          cleanPath === "/weight-loss-calculator"
            ? "bg-canvas-soft-2 text-ink font-semibold"
            : "text-body hover:text-ink hover:bg-canvas-soft-2"
        }`}
      >
        Weight Loss Calculator
      </a>
      <a
        href="/maintenance-calculator"
        class={`text-sm font-medium px-4 py-3 rounded-lg transition-all ${
          cleanPath === "/maintenance-calculator"
            ? "bg-canvas-soft-2 text-ink font-semibold"
            : "text-body hover:text-ink hover:bg-canvas-soft-2"
        }`}
      >
        Maintenance Calculator
      </a>
      <a
        href="/recipe-calculator"
        class={`text-sm font-medium px-4 py-3 rounded-lg transition-all ${
          cleanPath === "/recipe-calculator"
            ? "bg-canvas-soft-2 text-ink font-semibold"
            : "text-body hover:text-ink hover:bg-canvas-soft-2"
        }`}
      >
        Recipe Calorie Calculator
      </a>
    </nav>
  </div>
</header>

<script>
  // Handle theme toggles globally from this component
  function setupThemeToggle() {
    const themeToggle = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('theme-toggle-sun-icon');
    const moonIcon = document.getElementById('theme-toggle-moon-icon');

    function updateToggleIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        sunIcon?.classList.remove('hidden');
        moonIcon?.classList.add('hidden');
      } else {
        sunIcon?.classList.add('hidden');
        moonIcon?.classList.remove('hidden');
      }
    }

    updateToggleIcons();

    themeToggle?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
      updateToggleIcons();
    });
  }

  // Mobile menu toggle
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const nav = document.getElementById('mobile-nav');
    const iconOpen = document.getElementById('mobile-menu-icon-open');
    const iconClose = document.getElementById('mobile-menu-icon-close');

    btn?.addEventListener('click', () => {
      const isOpen = !nav?.classList.contains('hidden');
      if (isOpen) {
        nav?.classList.add('hidden');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        btn?.setAttribute('aria-expanded', 'false');
      } else {
        nav?.classList.remove('hidden');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
        btn?.setAttribute('aria-expanded', 'true');
      }
    });

    // Close on nav link click
    nav?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        nav?.classList.add('hidden');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        btn?.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Set up immediately and on page transitions if SPA-like, or on load
  setupThemeToggle();
  setupMobileMenu();
</script>
